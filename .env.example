# TomTom Traffic API — requer chave
# Cadastro: https://developer.tomtom.com/
# Limite: 2.500 req/dia no plano gratuito
TOMTOM_API_KEY=sua_chave_aqui

# Open-Meteo — NÃO precisa de chave
# Documentação: https://open-meteo.com/en/docs

# === Banco de dados ===
DB_USER=postgres
DB_PASS=senha_segura_aqui
DATABASE_URL=postgresql://postgres:senha_segura_aqui@db:5432/monitoramento

# === API interna ===
API_URL=http://api:8000
