# === APIs externas ===

# OpenRouteService — gratuito, sem cartão
# Cadastro: https://openrouteservice.org/dev/#/signup
# Limite: 2.000 req/dia no plano gratuito
TOMTOM_API_KEY=sua_chave_openrouteservice_aqui

# Open-Meteo — NÃO precisa de chave, deixe em branco
# Documentação: https://open-meteo.com/en/docs
# (não há nada a configurar aqui)

# === Banco de dados ===
DB_USER=postgres
DB_PASS=senha_segura_aqui
DATABASE_URL=postgresql://postgres:senha_segura_aqui@db:5432/monitoramento

# === API interna ===
API_URL=http://api:8000
